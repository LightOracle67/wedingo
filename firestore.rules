rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      // Se comprueba el email del ID token Y, como respaldo robusto, el UID
      // del superadmin registrado en platform/settings (escrito por el cliente
      // en cada login). Algunos tokens de Firebase no exponen el claim `email`
      // en request.auth.token.email, lo que causaba permission-denied aunque
      // el cliente validara correctamente.
      return request.auth != null
        && (request.auth.token.email in ['adriancl2001@gmail.com']
          || (exists(/databases/$(database)/documents/platform/settings)
            && get(/databases/$(database)/documents/platform/settings).data.superadminUid == request.auth.uid));
    }

    function sessionExists(tokenId) {
      return exists(/databases/$(database)/documents/invitations/$(tokenId));
    }

    /* Referencia al documento de sesión privado (subcolección _private/session).
       Existe solo cuando hay una sesión activa. No es legible públicamente. */
    function privateSessionRef(tokenId) {
      return /databases/$(database)/documents/invitations/$(tokenId)/_private/session;
    }

    /* Sesión activa: existe el documento de sesión privada y no ha expirado. */
    function hasActiveSession(tokenId) {
      return exists(privateSessionRef(tokenId))
        && get(privateSessionRef(tokenId)).data.sessionExpiresAt > request.time;
    }

    function isAuthenticatedAdmin(tokenId) {
      return hasActiveSession(tokenId) || isSuperAdmin();
    }

    function isSafeText(value) {
      return value is string
        && !value.matches('.*[<>"\\\\`].*')
        && !value.matches('(?i).*javascript:.*')
        && !value.matches('(?i).*\\bon\\w+\\s*=\\s*[\'\"].*')
        && value.size() <= 5000;
    }

    /* Hash SHA-256 hexadecimal (64 caracteres) de un token de setup. */
    function isValidTokenHash(hash) {
      return hash is string
        && hash.size() == 64
        && hash.matches('[0-9a-f]{64}');
    }

    /* El `data` de los medios (galería/audio/imágenes de config) es SIEMPRE
       cifrado AES-GCM en base64 (formato de crypto-utils: salt|iv|iteraciones|
       ciphertext, con cabecera >= 31 bytes). Exigir el alfabeto base64 y un
       mínimo de 44 caracteres impide alojar texto arbitrario o data URLs no
       cifrados (p. ej. data:text/html o SVG) bajo una sesión admin. */
    function isEncryptedMedia(data) {
      return data is string
        && data.size() >= 44
        && data.matches('[A-Za-z0-9+/=]+');
    }

    /* Un token de setup es válido si existe un registro en setupTokens cuyo
       documentId (el hash del token) apunta a esta invitación. */
    function setupTokenValid(tokenId, hash) {
      return isValidTokenHash(hash)
        && exists(/databases/$(database)/documents/setupTokens/$(hash))
        && get(/databases/$(database)/documents/setupTokens/$(hash)).data.inviteToken == tokenId;
    }

    /* Tope anti-spam por subcolección social (gifts/confirmedPeople). */
    function socialCounterCap(name) {
      // La lista pública de confirmados puede superar ampliamente 200 (tantos
      // como invitados confirmen con opt-in); el resto de subcolecciones
      // sociales usa 200.
      return name == 'confirmedPeople' ? 2000 : 200;
    }

    /* El contador invitations/{id}/_counters/{name} debe estar por debajo del
       tope. Si el contador no existe (invitación creada antes de introducir
       los contadores) se permite la escritura: el cliente lo crea de forma
       atómica en el mismo batch y el cap aplica a partir de ahí. */
    function socialCounterBelow(tokenId, name) {
      return !exists(/databases/$(database)/documents/invitations/$(tokenId)/_counters/$(name))
        || get(/databases/$(database)/documents/invitations/$(tokenId)/_counters/$(name)).data.count < socialCounterCap(name);
    }

    /* Texto largo visible en la invitación: longitud acotada y caracteres
       seguros (sin HTML/JS) para evitar XSS almacenado. */
    function isValidLongSafeText(value) {
      return isSafeText(value) && value.size() <= 2000;
    }

    /* Whitelist estricta de temas: rechaza cualquier valor que no sea un tema
       soportado por el cliente (THEME_VALUES). Evita que un valor arbitrario
       se guarde y rompa el renderizado o se use para inyección de estilos. */
    function isValidTheme(theme) {
      return theme is string
        && theme.matches('^(golden|forest|rose|linen-soft|blush-pearl|lavender-mist|champagne-bubble|amber-night|onyx-gold|midnight-royal|burgundy-velvet|sapphire-night|emerald-grove|plum-twilight|antique-ivory|deep-amethyst|rainbow|trans|nonbinary|lesbian|bi|pan|ace)$');
    }

    /* URL visible en la invitación: acotada y sin esquemas peligrosos.
       Bloquea javascript:, data:, vbscript: y protocol-relative (//evil).
       En RE2 el . NO cruza saltos de línea, así que se descarta además a todo
       valor que contenga \n\r\t (un atacante podía colar "java\nscript:...").
       Solo se aceptan enlaces http(s) absolutos con host. */
    function isValidSafeUrl(url) {
      return url is string
        && url.size() <= 1000
        && (url == ''
          || (!url.matches('.*[\\n\\r\\t].*')
            && url.matches('^https?://[^\\s/$.?#].[^\\s]*$')));
    }

/* Validación de configuración: solo campos críticos de seguridad.
   Validaciones de formato/UX se hacen en cliente (normalizeConfig).
   Se mantiene compacta para no superar el límite de 1000 expresiones. */
    function isValidInvitationUpdate(data) {
      return data.keys().hasAll(['firstName', 'secondName'])
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100 && isSafeText(data.firstName)
        && data.secondName is string && data.secondName.size() > 0 && data.secondName.size() <= 100 && isSafeText(data.secondName)
        && (!data.keys().hasAny(['theme']) || isValidTheme(data.theme))
        /* Textos visibles: longitud acotada y sin HTML/JS (XSS almacenado). */
        && (!data.keys().hasAny(['inviteMessage']) || (data.inviteMessage is string && data.inviteMessage.size() <= 500 && isSafeText(data.inviteMessage)))
        && (!data.keys().hasAny(['storyText']) || isValidLongSafeText(data.storyText))
        && (!data.keys().hasAny(['giftsInfo']) || isValidLongSafeText(data.giftsInfo))
        && (!data.keys().hasAny(['accommodationInfo']) || isValidLongSafeText(data.accommodationInfo))
        && (!data.keys().hasAny(['menuTexto']) || isValidLongSafeText(data.menuTexto))
        && (!data.keys().hasAny(['kidsPolicy']) || isValidLongSafeText(data.kidsPolicy))
        /* URLs: acotadas y sin javascript: (XSS). */
        && (!data.keys().hasAny(['weddingSiteURL']) || isValidSafeUrl(data.weddingSiteURL))
        && (!data.keys().hasAny(['instagramUrl']) || isValidSafeUrl(data.instagramUrl))
        && (!data.keys().hasAny(['accommodationURL']) || isValidSafeUrl(data.accommodationURL))
        /* adminUsername: solo alfanumérico minúsculas, máx 50. */
        && (!data.keys().hasAny(['adminUsername']) || (data.adminUsername is string && data.adminUsername.size() <= 50 && data.adminUsername.matches('^[a-z0-9]*$')))
        /* expectedGuests: entero 0..1000 como string. */
        && (!data.keys().hasAny(['expectedGuests']) || (
          data.expectedGuests is string
          && data.expectedGuests.matches('^[0-9]{0,4}$')
          && (data.expectedGuests.size() < 4 || data.expectedGuests <= "1000")
        ))
        /* privacyConsent: si se envía, debe ser true. */
        && (!data.keys().hasAny(['privacyConsent']) || data.privacyConsent == true)
        /* giftList/trivia: solo límite de tamaño (validación de estructura en cliente). */
        && (!data.keys().hasAny(['giftList']) || (data.giftList is string && data.giftList.size() <= 10000))
        && (!data.keys().hasAny(['trivia']) || (data.trivia is string && data.trivia.size() <= 10000));
    }

    match /invitations/{tokenId} {
      /* Lectura pública por documento (necesaria para la invitación),
         pero se prohíbe listar/enumerar la colección completa salvo para
         el superadmin (dashboard, exportación y tokens). */
      allow get: if true;
      allow list: if isSuperAdmin();
      /* Alta inicial: el token de setup ya limita quién puede crearla, así que
         se usa la validación reducida (igual que el update). La validación
         completa superaba el límite de 1000 expresiones en producción.
         La sesión NO puede auto-provisionarse en el create: los campos de
         sesión los gestiona exclusivamente su regla dedicada, y el tokenId
         debe tener el formato que genera la app (10 caracteres alfanuméricos)
         para limitar el alojamiento de contenido arbitrario en el dominio. */
      allow create: if isValidInvitationUpdate(request.resource.data)
        && tokenId.matches('^[A-Za-z0-9]{10}$')
        /* La sesión NO puede auto-provisionarse en el create (solo su regla
           dedicada) ni fijar _visits. Se exige la prueba de conocimiento del
           token de setup (setupTokenValid): el primer guardado del cliente
           adjunta el hash, y así no se pueden alojar invitaciones falsas. */
        && !request.resource.data.keys().hasAny(['activeSession', 'sessionExpiresAt', '_visits'])
        /* Campos de superadmin: verified/adminNotes/manualExpiry solo los puede
           fijar el superadmin; un admin normal solo puede escribirlos con sus
           valores por defecto (normalizeConfig los incluye en el payload). */
        && (!request.resource.data.keys().hasAny(['verified', 'adminNotes', 'manualExpiry', 'status', 'tags', 'rsvpCapacity', 'rsvpSignatureEnabled'])
          || (request.resource.data.verified == 'false' && request.resource.data.adminNotes == ''
            && request.resource.data.manualExpiry == '' && request.resource.data.status == 'active'
            && request.resource.data.tags == '' && request.resource.data.rsvpCapacity == ''
            && request.resource.data.rsvpSignatureEnabled == 'false')
          || isSuperAdmin())
        && (isSuperAdmin()
          || (setupTokenValid(tokenId, request.resource.data.setupTokenHash)
            && !exists(/databases/$(database)/documents/invitations/$(tokenId))));
      /* Actualización de configuración: solo admin con sesión activa o
         superadmin. Cualquier cuenta autenticada de Firebase Auth NO puede
         editar invitaciones de terceros (evita defacing/phisning).
         _visits se excluye: lo gestiona exclusivamente su propia regla con
         cota de incremento (sin esto un update global con sesión podía fijar
         _visits arbitrariamente). */
      allow update: if isValidInvitationUpdate(request.resource.data)
        && (isSuperAdmin() || hasActiveSession(tokenId))
        /* _visits se conserva en el merge (el doc ya lo tiene tras una
           visita): solo se prohíbe que el update lo MODIFIQUE. La condición
           anterior (hasAny) bloqueaba el guardado cuando el doc tenía
           _visits, porque el merge lo incluía en el request.resource.data. */
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['_visits'])
        /* Los campos de sesión solo los gestiona su regla dedicada (acotada
           a 48 h): el update de configuración no puede fijarlos, o un cliente
           con sesión podría extenderla indefinidamente sin volver a autenticar
           (la rotación de token no la revocaría). */
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeSession', 'sessionExpiresAt', 'setupTokenHash'])
        /* Campos de superadmin: cambiarlos exige ser superadmin (el admin solo
           puede escribirlos con sus valores por defecto). */
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'adminNotes', 'manualExpiry', 'status', 'tags', 'rsvpCapacity', 'rsvpSignatureEnabled'])
          || (request.resource.data.verified == 'false' && request.resource.data.adminNotes == ''
            && request.resource.data.manualExpiry == '' && request.resource.data.status == 'active'
            && request.resource.data.tags == '' && request.resource.data.rsvpCapacity == ''
            && request.resource.data.rsvpSignatureEnabled == 'false')
          || isSuperAdmin());
      /* Incremento de contador de visitas: cualquiera puede incrementar
         _visits, pero solo en pasos razonables (máx +10 por request) para
         evitar inflar el contador de forma arbitraria. El cliente usa
         increment(1), así que no se rompe. */
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['_visits'])
        && request.resource.data._visits is int
        && request.resource.data._visits >= 0
        /* Tope global: evita inflar _visits hasta números absurdos con +10
           repetidos (una invitación real no supera este orden de magnitud). */
        && request.resource.data._visits <= 1000000
        && (resource.data.keys().hasAny(['_visits'])
          ? (request.resource.data._visits >= resource.data._visits
            && request.resource.data._visits <= resource.data._visits + 10)
          : request.resource.data._visits <= 10);

/* Limpieza del token legacy: solo el superadmin retira los campos
          `_activeSetupToken` y `legacyToken` del documento público. */
       allow update: if isSuperAdmin()
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['_activeSetupToken', 'legacyToken']);
       allow delete: if isSuperAdmin();

       /* ── Subcolección privada de sesión ─────────────────────────────────────
          Almacena activeSession, sessionExpiresAt y setupTokenHash de forma
          privada (no legible públicamente). Evita forja de sesión (S-C1).
          ───────────────────────────────────────────────────────────────────── */
       match /_private/session {
         /* Creación/renovación de sesión: exige prueba de conocimiento del
            token de setup (hash con registro en setupTokens). sessionExpiresAt
            acotada a 30min-48h respecto a request.time. */
         allow create: if setupTokenValid(tokenId, request.resource.data.setupTokenHash)
           && request.resource.data.sessionExpiresAt >= request.time + duration.value(30, 'm')
           && request.resource.data.sessionExpiresAt <= request.time + duration.value(48, 'h')
           && request.resource.data.keys().hasOnly(['activeSession', 'sessionExpiresAt', 'setupTokenHash', 'createdAt']);
         /* Renovación: solo si hay sesión activa O se aporta prueba de token válida. */
         /* La reactivación sobre un doc existente llega como update vía
            setDoc con la MISMA forma de 4 claves que el create (incluye
            createdAt). Se aceptan ambas formas: 3 claves (renovación pura)
            o 4 claves (reactivación completa). Sin esto, todo segundo login
            sobre una invitación con sesión previa era permission-denied. */
         allow update: if (hasActiveSession(tokenId) || setupTokenValid(tokenId, request.resource.data.setupTokenHash))
           && request.resource.data.sessionExpiresAt >= request.time + duration.value(30, 'm')
           && request.resource.data.sessionExpiresAt <= request.time + duration.value(48, 'h')
           && (request.resource.data.keys().hasOnly(['activeSession', 'sessionExpiresAt', 'setupTokenHash'])
             || request.resource.data.keys().hasOnly(['activeSession', 'sessionExpiresAt', 'setupTokenHash', 'createdAt']));
         /* Cierre de sesión (logout): solo admin con sesión activa o superadmin. */
         allow update: if (hasActiveSession(tokenId) || isSuperAdmin())
           && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeSession', 'sessionExpiresAt'])
           && request.resource.data.activeSession == null
           && request.resource.data.sessionExpiresAt == null;
         /* Lectura: solo admin autenticado o superadmin. */
         allow get: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
         allow delete: if isSuperAdmin();
       }

       match /gallery/{imageId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['data', 'description', 'position', 'createdAt', 'originalName', 'originalSize'])
          && request.resource.data.data is string
          && isEncryptedMedia(request.resource.data.data)
          && request.resource.data.data.size() <= 1048576
          && request.resource.data.description is string && request.resource.data.description.size() <= 200
          && request.resource.data.position is int
          && isAuthenticatedAdmin(tokenId);
        /* El update solo permite retocar la descripción o la POSICIÓN de
           reordenado (updateGalleryOrder reescribe {position} en lote al
           arrastrar en el editor); el resto de campos solo se crean. */
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['description', 'position'])
          && (!request.resource.data.keys().hasAny(['description']) || (request.resource.data.description is string && request.resource.data.description.size() <= 200))
          && (!request.resource.data.keys().hasAny(['position']) || request.resource.data.position is int)
          && isAuthenticatedAdmin(tokenId);
        allow delete: if isAuthenticatedAdmin(tokenId);
      }

      match /audio/{docId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['chunkIndex', 'data', 'totalChunks', 'attempt', 'createdAt'])
          && request.resource.data.data is string
          && isEncryptedMedia(request.resource.data.data)
          && request.resource.data.data.size() <= 524288
          && request.resource.data.chunkIndex is int
          && request.resource.data.totalChunks is int && request.resource.data.totalChunks <= 400
          && isAuthenticatedAdmin(tokenId);
        allow delete: if isAuthenticatedAdmin(tokenId);
      }

      match /configImages/{imageId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['data', 'createdAt'])
          && request.resource.data.data is string
          && isEncryptedMedia(request.resource.data.data)
          && request.resource.data.data.size() <= 1048576
          && isAuthenticatedAdmin(tokenId);
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'createdAt'])
          && request.resource.data.data is string
          && isEncryptedMedia(request.resource.data.data)
          && request.resource.data.data.size() <= 1048576
          && isAuthenticatedAdmin(tokenId);
        allow delete: if isAuthenticatedAdmin(tokenId);
      }

      /* ── Contribuciones de los invitados (funciones sociales) ────────────
         Reservas de regalo. El texto público se sanea con isSafeText; solo el
         admin/superadmin puede borrar. */
      /* Lista pública de confirmados (prueba social): invitations/{token}/
         confirmedPeople/{itemId} con { name }. Solo nombres, creados una vez
         (create-only: un documento ya existente no se puede sobrescribir, por
         lo que un atacante no puede suplantar a otro invitado creándolo dos
         veces), con cap anti-spam y texto seguro. La lectura es pública. La
         app YA NO escribe aquí (la lista pública de confirmados se retiró en
         v2.159 al eliminarse el opt-in del RSVP): las reglas se mantienen
         para proteger los documentos legacy que siguen en producción. */
      match /confirmedPeople/{itemId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && !exists(/databases/$(database)/documents/invitations/$(tokenId)/confirmedPeople/$(itemId))
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && isSafeText(request.resource.data.name)
          && socialCounterBelow(tokenId, 'confirmedPeople');
        allow delete: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
      }
      /* Contadores anti-spam de las subcolecciones sociales: invitations/{id}/
         _counters/{name} con { count }. El cliente los incrementa de forma
         atómica en el mismo batch que crea el documento (addDoc + setDoc con
         merge), replicando el patrón de rsvpResponses. Un contador inexistente
         (invitación antigua) NO bloquea la creación: el cap se aplica desde
         el primer documento de la versión que introduce los contadores. */
      /* Registro de acceso/sesiones por invitación (F4-2/F4-8): quién y cuándo
         intentó entrar al setup/admin (login fallido o exitoso). Sin IP (solo
         userAgent anonimizado); lectura solo admin/superadmin.
         L2: TTL automático 90 días (requiere Cloud Function en plan Blaze).
         La regla de retención se implementa en functions/index.ts (cleanupExpiredData). */
      match /accessLog/{entryId} {
        allow create: if request.resource.data.keys().hasOnly(['action', 'detail', 'ts', 'userAgent'])
          && request.resource.data.action in ['login_success', 'login_failed', 'session_created', 'session_revoked']
          && request.resource.data.detail is string && request.resource.data.detail.size() <= 200
          && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 200;
        allow read, delete: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
      }

      /* Auditoría de cambios de configuración (F5-3): qué campos se
         modificaron en cada guardado del setup. Lectura solo admin/superadmin. */
      match /configLog/{entryId} {
        allow create: if request.resource.data.keys().hasOnly(['fields', 'ts', 'userAgent'])
          && request.resource.data.fields is string && request.resource.data.fields.size() <= 2000
          && request.resource.data.userAgent is string && request.resource.data.userAgent.size() <= 200;
        allow read, delete: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
      }

      /* Historial de visitas por día (F18): invitations/{token}/visitLog/{day}
         con { count }. Cualquiera puede incrementarlo (como _visits) pero solo
         en pasos razonables por día (máx +20 por request sobre el valor
         actual) y con el id del documento en formato fecha YYYY-MM-DD. La
         lectura es solo admin/superadmin (dato interno de la pareja). */
      match /visitLog/{day} {
        allow read: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
        allow create: if day.matches('\\d{4}-\\d{2}-\\d{2}')
          && request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && request.resource.data.count <= 20;
        allow update: if day.matches('\\d{4}-\\d{2}-\\d{2}')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && request.resource.data.count <= 100000
          && (resource.data.keys().hasAny(['count'])
            ? (request.resource.data.count >= resource.data.count
              && request.resource.data.count <= resource.data.count + 20)
            : request.resource.data.count <= 20);
      }

      match /_counters/{counterName} {
        allow read: if true;
        // create limitado a count 0/1: 0 es la inicialización de ConfigContext
        // al guardar la invitación, 1 es el increment del primer documento
        // desde un contador inexistente (setDoc con merge). Un atacante no
        // puede crear el contador directamente en el cap para "quemar" las
        // escrituras de una invitación (como rsvpResponses, que limita a 1).
        allow create: if request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && request.resource.data.count <= 1;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count <= socialCounterCap(counterName);
        allow delete: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
      }

      /* Registro de consentimiento del visitante (GDPR art. 7.1, consentimiento
         demostrable): cada decisión del banner de cookies (aceptar/rechazar/
         preferencias) se registra en el servidor con la versión de la política
         y timestamp. Sin datos personales del visitante (solo estado+versión),
         con documentId auto-generado. Lectura/gestión solo admin/superadmin.
         L5: Política ES - versión de política en español (v2026.1) y tracking de idioma. */
      match /consentLog/{entryId} {
        allow create: if request.resource.data.keys().hasOnly(['status', 'version', 'ts', 'lang'])
          && request.resource.data.status in ['accepted', 'rejected']
          && request.resource.data.version is string && request.resource.data.version.size() <= 20
          && (!request.resource.data.keys().hasAny(['lang']) || (request.resource.data.lang is string && request.resource.data.lang.matches('^(es|en)$')))
          && request.resource.data.ts is timestamp;
        allow read, update, delete: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
      }

      /* Caja de recuerdos de voz (diferencial): los invitados graban una nota
         de voz corta para la pareja. Se trocea como el audio de música y se
         controla con el contador `voicenotes`. Lectura pública, creación
         pública (con cap), borrado solo admin/superadmin.
         L4: Consentimiento de voz - el invitado debe confirmar que su nota
         puede usarse (GDPR art. 6.1.a consentimiento explícito). */

      /* Muro de fotos del día (diferencial): los invitados suben fotos a un
         álbum compartido durante la boda. Cifradas como la galería (data
         base64 AES-GCM), lectura pública, creación pública con cap, borrado
         admin. Se exige isEncryptedMedia (alfabeto base64 + longitud mínima)
         tanto como en gallery/audio/configImages para impedir alojar texto
         arbitrario, data URLs o SVG en claro bajo la invitación. */

      /* Buzón de mensajes privados (diferencial): mensajes que SOLO lee la
         pareja (admin). Creación pública con cap; lectura/borrado solo
         admin/superadmin (privacidad). */

      /* Programa de brindis/discursos (diferencial): los invitados se apuntan
         a hablar. Lectura pública, creación pública con cap, borrado admin. */

      /* Mapa del recinto (diferencial): puntos de interés dibujados por el
         admin (coordenadas en %) visibles para los invitados. */
      match /venuepoints/{pointId} {
        allow read: if true;
        allow create, update: if isAuthenticatedAdmin(tokenId) || isSuperAdmin()
          && request.resource.data.keys().hasOnly(['label', 'x', 'y', 'color'])
          && request.resource.data.label is string && request.resource.data.label.size() <= 80 && isSafeText(request.resource.data.label)
          && request.resource.data.x is number && request.resource.data.x >= 0 && request.resource.data.x <= 100
          && request.resource.data.y is number && request.resource.data.y >= 0 && request.resource.data.y <= 100
          && request.resource.data.color is string && request.resource.data.color.size() <= 12;
        allow delete: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
      }

      /* Distribución: SECCIONES del recinto (cada una con su propio mapa).
         Lectura pública (el invitado ve su mesa), escritura solo admin. */
      match /sections/{sectionId} {
        allow read: if true;
        allow create, update: if isAuthenticatedAdmin(tokenId) || isSuperAdmin()
          && request.resource.data.keys().hasOnly(['name', 'createdAt'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 80 && isSafeText(request.resource.data.name);
        allow delete: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();

        /* Mesas de la sección: forma, posición, tamaño (PÍXELES), rotación,
           plazas e invitados CONFIRMADOS (solo admin escribe; lectura pública).
           En círculo y cuadrado ancho == alto SIEMPRE. */
        match /tables/{tableId} {
          allow read: if true;
          allow create, update: if isAuthenticatedAdmin(tokenId) || isSuperAdmin()
            && request.resource.data.keys().hasOnly(['name', 'shape', 'x', 'y', 'w', 'h', 'rotation', 'seats', 'guests', 'createdAt'])
            && request.resource.data.name is string && request.resource.data.name.size() <= 80 && isSafeText(request.resource.data.name)
            && request.resource.data.shape in ['circle', 'rect', 'oval', 'square']
            && request.resource.data.x is number && request.resource.data.x >= 0 && request.resource.data.x <= 100
            && request.resource.data.y is number && request.resource.data.y >= 0 && request.resource.data.y <= 100
            && request.resource.data.w is number && request.resource.data.w >= 20 && request.resource.data.w <= 500
            && request.resource.data.h is number && request.resource.data.h >= 20 && request.resource.data.h <= 500
            && (request.resource.data.shape == 'circle' || request.resource.data.shape == 'square')
                ? request.resource.data.w == request.resource.data.h : true
            && request.resource.data.rotation is number && request.resource.data.rotation >= -180 && request.resource.data.rotation <= 180
            && request.resource.data.seats is int && request.resource.data.seats >= 0 && request.resource.data.seats <= 100
            && request.resource.data.guests is list && request.resource.data.guests.size() <= 200
            && request.resource.data.guests.all(g, g is string && g.size() <= 120);
          allow delete: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
        }
      }
    }

    /* Registros de tokens de setup. El documentId es el hash SHA-256 del token
       (secreto ~2^158), por lo que solo es recuperable con `get` si se conoce
       el token (que permite calcular el documentId). La enumeración (`list`)
       se prohíbe. El `get` debe permitirse SIN sesión activa: es justo lo que
       necesita el flujo de login para localizar la invitación a partir del
       token antes de activar la sesión. La creación solo es válida para
       invitaciones inexistentes (alta inicial) o con sesión activa. */
    match /setupTokens/{hashId} {
      allow get: if true;
      /* Listar solo superadmin: permite limpiar hashes huérfanos al borrar
         invitaciones (query por inviteToken). */
      allow list: if isSuperAdmin();
      /* El alta inicial crea el registro antes de que exista la invitación;
         las rotaciones se hacen con sesión activa. Se exige un formato de
         invitación estricto (10 caracteres alfanuméricos, como genera la app)
         para limitar el spam de registros de tokens hacia invitaciones
         inexistentes. */
      allow create: if isValidTokenHash(hashId)
        && request.resource.data.keys().hasOnly(['inviteToken', 'createdAt'])
        && request.resource.data.inviteToken is string
        && request.resource.data.inviteToken.matches('^[A-Za-z0-9]{10}$')
        && (!exists(/databases/$(database)/documents/invitations/$(request.resource.data.inviteToken))
          || hasActiveSession(request.resource.data.inviteToken)
          || isSuperAdmin());
      allow update: if isSuperAdmin()
        || (resource.data.inviteToken is string
          && hasActiveSession(resource.data.inviteToken));
      allow delete: if isSuperAdmin()
        || (resource.data.inviteToken is string
          && hasActiveSession(resource.data.inviteToken));
    }

    /* Agrupación y contador por invitación: rsvpResponses/{inviteToken} guarda
       el recuento de respuestas (tope 500 anti-spam) y es el "namespace" de la
       subcolección de respuestas de esa invitación. */
    match /rsvpResponses/{inviteToken} {
      /* El contador (solo un entero) es público: useRsvp lo lee para
         incrementarlo en cada respuesta sin sesión de admin. Restringir
         la lectura aquí rompía el RSVP a partir de la segunda respuesta
         (el cliente siempre veía count 0 y el batch fallaba). */
      allow read: if true;
       /* El contador público se compone de `count` (total de respuestas, tope
          500 anti-spam) y `attendingCount` (solo confirmaciones que asisten,
          para el aforo real que ve el invitado). `attendingCount` debe ser un
          entero no negativo y nunca superar `count`. Los incrementos públicos
          suman exactamente +1 a `count` (==actual+1, exigido por las reglas);
          los decrementos quedan restringidos a sesión activa o superadmin.
          Un cliente malicioso solo podría alterar `attendingCount` dentro del
          rango [0, count], que es un campo de DISPLAY (el tope anti-spam real
          es `count`), así que el daño posible es limitado a la información de
          aforo que reciben los demás, nunca a la capacidad real de escritura. */
       allow create: if request.resource.data.keys().hasOnly(['count', 'attendingCount'])
         && request.resource.data.count is int
         && request.resource.data.count >= 0
         && request.resource.data.count <= 1
         && request.resource.data.attendingCount is int
         && request.resource.data.attendingCount >= 0
         && request.resource.data.attendingCount <= request.resource.data.count;
       allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'attendingCount'])
         && request.resource.data.count is int
         && request.resource.data.count >= 0
         && request.resource.data.count <= 500
         && request.resource.data.attendingCount is int
         && request.resource.data.attendingCount >= 0
         && request.resource.data.attendingCount <= request.resource.data.count
         && (request.resource.data.count == resource.data.count + 1
           /* Decremento al retirar/borrar respuestas: solo con sesión activa o
              superadmin. Se permite cualquier decremento (>=1) porque un borrado
              en lote o un vaciado eliminan varios documentos a la vez
              (increment(-N)), no solo uno. */
           || ((isSuperAdmin() || hasActiveSession(inviteToken))
             && request.resource.data.count <= resource.data.count - 1));
      allow delete: if isSuperAdmin();
    }

    /* Respuestas RSVP en la subcolección de su invitación:
       rsvpResponses/{inviteToken}/responses/{responseId} */
    match /rsvpResponses/{inviteToken}/responses/{responseId} {
      allow create: if request.resource.data.keys().hasAll(['guestName', 'attendance', 'dietaryInfo', 'submittedAt', 'inviteToken', 'privacyConsent'])
        && request.resource.data.inviteToken == inviteToken
        && request.resource.data.guestName is string
        && request.resource.data.guestName.size() > 0
        && request.resource.data.guestName.size() <= 120
        && isSafeText(request.resource.data.guestName)
        && request.resource.data.attendance in ['yes', 'no']
        && request.resource.data.dietaryInfo is string
        && request.resource.data.dietaryInfo.size() <= 4000
        && isSafeText(request.resource.data.dietaryInfo)
        && request.resource.data.privacyConsent == true
        && request.resource.data.privacyConsentAt is timestamp
        && (
          !request.resource.data.keys().hasAny(['healthConsent'])
          || request.resource.data.healthConsent == true
        )
        && (
          (request.resource.data.dietaryInfo == ""
            && (!request.resource.data.keys().hasAny(['allergiesOther']) || request.resource.data.allergiesOther == ""))
          || request.resource.data.healthConsent == true
        )
        /* Consentimiento parental en el SERVIDOR: si la fecha de nacimiento
           indica que el invitado es menor de 14 años (fecha de nacimiento
           posterior al límite actual), se exige parentalConsent (GDPR art. 8).
           La edad exacta la valida el cliente.
           IMPORTANTE: actualiza esta fecha cada año. El script CI
           `node scripts/check-consent-cutoff.js` falla si queda obsoleta. */
        && (
          !request.resource.data.keys().hasAny(['birthDate'])
          || request.resource.data.birthDate == ""
          || request.resource.data.birthDate < "2012-08-27"
          || request.resource.data.parentalConsent == true
        )
        && exists(/databases/$(database)/documents/rsvpResponses/$(inviteToken))
        && get(/databases/$(database)/documents/rsvpResponses/$(inviteToken)).data.count < 500
&& (request.resource.data.keys().hasOnly(['guestName', 'attendance', 'dietaryInfo', 'submittedAt', 'inviteToken', 'privacyConsent', 'privacyConsentAt', 'birthDate', 'parentalConsent', 'menuSelection', 'mealChoice', 'healthConsent', 'healthConsentAt', 'companions', 'menuHeadcounts', 'guestNames', 'attendees', 'notAttendingCount', 'companionCount', 'companionNames', 'companionMenus', 'companionAllergies', 'companionAllergiesOther', 'allergiesOther', 'isChild', 'rsvpType', 'mainGuestDocId', 'mainGuestName', 'companionDocIds', 'transportChoice', 'transportMode', 'transportTime', 'transportPlace', 'companionTransportChoices', 'companionTransportModes', 'companionTransportTimes', 'companionTransportPlaces', 'userAgent', 'digitalSignature', 'phone', 'email', 'contactConsent', 'childrenCount', 'childrenAllergies', 'childrenAllergiesOther'])
      || request.resource.data.keys().hasOnly(['guestName', 'attendance', 'dietaryInfo', 'submittedAt', 'inviteToken', 'privacyConsent', 'privacyConsentAt', 'birthDate', 'parentalConsent', 'menuSelection', 'mealChoice', 'companions', 'menuHeadcounts', 'guestNames', 'attendees', 'notAttendingCount', 'companionCount', 'companionNames', 'companionMenus', 'companionAllergies', 'companionAllergiesOther', 'allergiesOther', 'isChild', 'rsvpType', 'mainGuestDocId', 'mainGuestName', 'companionDocIds', 'transportChoice', 'transportMode', 'transportTime', 'transportPlace', 'companionTransportChoices', 'companionTransportModes', 'companionTransportTimes', 'companionTransportPlaces', 'userAgent', 'digitalSignature', 'phone', 'email', 'contactConsent', 'childrenCount', 'childrenAllergies', 'childrenAllergiesOther']))
        // Flag ¿es niño?: booleano opcional (modelo GDPR-minimizado que
        // sustituye a birthDate/parentalConsent). El consentimiento parental
        // se asume: el invitado principal es el responsable del menor.
        && (!request.resource.data.keys().hasAny(['isChild']) || request.resource.data.isChild is bool)
        && (!request.resource.data.keys().hasAny(['transportMode']) || request.resource.data.transportMode is string)
        && (!request.resource.data.keys().hasAny(['transportChoice']) || (request.resource.data.transportChoice is string && request.resource.data.transportChoice.size() <= 20))
        && (!request.resource.data.keys().hasAny(['transportTime']) || (request.resource.data.transportTime is string && request.resource.data.transportTime.size() <= 5))
        && (!request.resource.data.keys().hasAny(['transportPlace']) || (request.resource.data.transportPlace is string && request.resource.data.transportPlace.size() <= 120 && isSafeText(request.resource.data.transportPlace)))
        && (!request.resource.data.keys().hasAny(['companionTransportChoices']) || request.resource.data.companionTransportChoices is list)
        && (!request.resource.data.keys().hasAny(['companionTransportModes']) || request.resource.data.companionTransportModes is list)
        && (!request.resource.data.keys().hasAny(['companionTransportTimes']) || request.resource.data.companionTransportTimes is list)
        /* Cotas y tipos de los agregados RSVP: la app escribe `companions` como
           número (recuento de acompañantes), `companionCount`/`childrenCount`/
           `notAttendingCount` como números, `attendees` como lista y las familias
           companionX como listas paralelas alineadas. Sin estas guardas un cliente
           sin autenticar podía persistir strings/objetos arbitrarios (p. ej.
           companions:"pwned", demostrado en pre-producción) o listas desmesuradas.
           El patrón !hasAny || (tipo && cota) solo aplica cuando el campo viene en
           el write, así que las escrituras parciales siguen válidas. Las cotas
           (100 acompañantes / 500 asistentes) son superiores a cualquier límite
           de la UI y conviven con el tope global del contador (<500). */
        && (!request.resource.data.keys().hasAny(['companions']) || (request.resource.data.companions is number && request.resource.data.companions >= 0 && request.resource.data.companions <= 100))
        && (!request.resource.data.keys().hasAny(['companionCount']) || (request.resource.data.companionCount is number && request.resource.data.companionCount >= 0 && request.resource.data.companionCount <= 100))
        && (!request.resource.data.keys().hasAny(['notAttendingCount']) || (request.resource.data.notAttendingCount is number && request.resource.data.notAttendingCount >= 0 && request.resource.data.notAttendingCount <= 500))
        && (!request.resource.data.keys().hasAny(['childrenCount']) || (request.resource.data.childrenCount is number && request.resource.data.childrenCount >= 0 && request.resource.data.childrenCount <= 500))
        && (!request.resource.data.keys().hasAny(['attendees']) || (request.resource.data.attendees is list && request.resource.data.attendees.size() <= 500))
        && (!request.resource.data.keys().hasAny(['menuHeadcounts']) || (request.resource.data.menuHeadcounts is list && request.resource.data.menuHeadcounts.size() <= 100))
        && (!request.resource.data.keys().hasAny(['guestNames']) || (request.resource.data.guestNames is string && request.resource.data.guestNames.size() <= 200))
        && (!request.resource.data.keys().hasAny(['companionNames']) || (request.resource.data.companionNames is list && request.resource.data.companionNames.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionMenus']) || (request.resource.data.companionMenus is list && request.resource.data.companionMenus.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionAllergies']) || (request.resource.data.companionAllergies is list && request.resource.data.companionAllergies.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionAllergiesOther']) || (request.resource.data.companionAllergiesOther is list && request.resource.data.companionAllergiesOther.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionDocIds']) || (request.resource.data.companionDocIds is list && request.resource.data.companionDocIds.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionTransportChoices']) || (request.resource.data.companionTransportChoices is list && request.resource.data.companionTransportChoices.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionTransportModes']) || (request.resource.data.companionTransportModes is list && request.resource.data.companionTransportModes.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionTransportTimes']) || (request.resource.data.companionTransportTimes is list && request.resource.data.companionTransportTimes.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionTransportPlaces']) || (request.resource.data.companionTransportPlaces is list && request.resource.data.companionTransportPlaces.size() <= 100));

      /* Lectura separada en get (doc individual) y list (consultas):
         el invitado público (sin sesión) puede hacer getDoc SOLO de su
         propia respuesta, cuyo id deriva deterministamente de su nombre
         normalizado (main_<hash>). La regla no puede comprobar el hash
         del nombre pedido, así que el mínimo de exposición es restringir
         (a) a docs principales de esta misma invitación y (b) a un get
         individual: un list/query seguiría devolviendo TODOS los docs de
         la invitación y lo bloqueamos. Así, el invitado escribe su
         nombre, la app deriva el id y hace getDoc; sin conocer el id
         derivado de otro invitado (nombre normalizado exacto) no hay
         fuga, y las alergias siguen cifradas en dietaryInfo. Los docs de
         acompañantes (comp_*) siguen restringidos a sesión/superadmin. */
      allow get: if isSuperAdmin()
        || hasActiveSession(inviteToken)
        || (resource.data.inviteToken == inviteToken
          && resource.data.rsvpType == 'main');
      allow list: if isSuperAdmin()
        || hasActiveSession(inviteToken);

      allow update: if request.resource.data.attendance in ['yes', 'no']
        && request.resource.data.dietaryInfo is string
        && request.resource.data.dietaryInfo.size() <= 4000
        && isSafeText(request.resource.data.dietaryInfo)
        && request.resource.data.inviteToken == inviteToken
        && hasActiveSession(inviteToken)
        && request.resource.data.privacyConsent == true
        && (!request.resource.data.keys().hasAny(['guestName']) || (request.resource.data.guestName is string && request.resource.data.guestName.size() <= 120 && isSafeText(request.resource.data.guestName)))
        /* Mismas guardas de tipos y cotas que en create: la edición de una
           respuesta (con sesión activa) tampoco puede introducir tipos
           incoherentes ni listas desmesuradas. Patrón !hasAny || para no
           afectar a actualizaciones parciales que omiten estos campos. */
        && (!request.resource.data.keys().hasAny(['companions']) || (request.resource.data.companions is number && request.resource.data.companions >= 0 && request.resource.data.companions <= 100))
        && (!request.resource.data.keys().hasAny(['companionCount']) || (request.resource.data.companionCount is number && request.resource.data.companionCount >= 0 && request.resource.data.companionCount <= 100))
        && (!request.resource.data.keys().hasAny(['notAttendingCount']) || (request.resource.data.notAttendingCount is number && request.resource.data.notAttendingCount >= 0 && request.resource.data.notAttendingCount <= 500))
        && (!request.resource.data.keys().hasAny(['childrenCount']) || (request.resource.data.childrenCount is number && request.resource.data.childrenCount >= 0 && request.resource.data.childrenCount <= 500))
        && (!request.resource.data.keys().hasAny(['attendees']) || (request.resource.data.attendees is list && request.resource.data.attendees.size() <= 500))
        && (!request.resource.data.keys().hasAny(['menuHeadcounts']) || (request.resource.data.menuHeadcounts is list && request.resource.data.menuHeadcounts.size() <= 100))
        && (!request.resource.data.keys().hasAny(['guestNames']) || (request.resource.data.guestNames is string && request.resource.data.guestNames.size() <= 200))
        && (!request.resource.data.keys().hasAny(['companionNames']) || (request.resource.data.companionNames is list && request.resource.data.companionNames.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionMenus']) || (request.resource.data.companionMenus is list && request.resource.data.companionMenus.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionAllergies']) || (request.resource.data.companionAllergies is list && request.resource.data.companionAllergies.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionAllergiesOther']) || (request.resource.data.companionAllergiesOther is list && request.resource.data.companionAllergiesOther.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionDocIds']) || (request.resource.data.companionDocIds is list && request.resource.data.companionDocIds.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionTransportChoices']) || (request.resource.data.companionTransportChoices is list && request.resource.data.companionTransportChoices.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionTransportModes']) || (request.resource.data.companionTransportModes is list && request.resource.data.companionTransportModes.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionTransportTimes']) || (request.resource.data.companionTransportTimes is list && request.resource.data.companionTransportTimes.size() <= 100))
        && (!request.resource.data.keys().hasAny(['companionTransportPlaces']) || (request.resource.data.companionTransportPlaces is list && request.resource.data.companionTransportPlaces.size() <= 100))
        && request.resource.data.keys().hasOnly(['attendance', 'dietaryInfo', 'privacyConsent', 'privacyConsentAt', 'healthConsent', 'healthConsentAt', 'birthDate', 'parentalConsent', 'menuSelection', 'mealChoice', 'guestName', 'submittedAt', 'inviteToken', 'companions', 'menuHeadcounts', 'guestNames', 'attendees', 'notAttendingCount', 'companionCount', 'companionNames', 'companionMenus', 'companionAllergies', 'companionAllergiesOther', 'allergiesOther', 'isChild', 'rsvpType', 'mainGuestDocId', 'mainGuestName', 'companionDocIds', 'transportChoice', 'transportMode', 'transportTime', 'transportPlace', 'companionTransportChoices', 'companionTransportModes', 'companionTransportTimes', 'companionTransportPlaces', 'userAgent', 'digitalSignature', 'phone', 'email', 'contactConsent', 'childrenCount', 'childrenAllergies', 'childrenAllergiesOther']);

      allow delete: if isSuperAdmin()
        || hasActiveSession(inviteToken);
    }

    /* Lectura global de respuestas (collectionGroup "responses"): solo el
       superadmin puede agregar/exportar datos de todas las invitaciones. */
    match /{path=**}/responses/{responseId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    /* Registro de auditoría: solo el superadmin puede registrarlo (evita
       envenenar el log con entradas falsas). */
    match /auditLog/{docId} {
      allow create: if isSuperAdmin()
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 100;
      allow read: if isSuperAdmin();
    }

    /* Ajustes globales de la plataforma (banner, mantenimiento, listas
       bloqueadas, umbral de expiración): lectura pública para mostrar avisos,
       escritura SOLO superadmin. */
    match /platform/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /couples/{document=**} { allow read, write: if false; }
    match /dataconnect/{document=**} { allow read, write: if false; }
  }
}
