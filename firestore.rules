rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSuperAdmin() {
      return request.auth != null
        && request.auth.token.email in ['adriancl2001@gmail.com'];
    }

    function sessionExists(tokenId) {
      return exists(/databases/$(database)/documents/invitations/$(tokenId));
    }

    function hasActiveSession(tokenId) {
      return sessionExists(tokenId)
        && get(/databases/$(database)/documents/invitations/$(tokenId)).data.activeSession is timestamp
        && get(/databases/$(database)/documents/invitations/$(tokenId)).data.sessionExpiresAt is timestamp
        && get(/databases/$(database)/documents/invitations/$(tokenId)).data.sessionExpiresAt > request.time;
    }

    function isAuthenticatedAdmin(tokenId) {
      return hasActiveSession(tokenId) || isSuperAdmin();
    }

    function isSafeText(value) {
      return value is string
        && !value.matches('.*[<>"\\\\`].*')
        && !value.matches('(?i).*javascript:.*')
        && !value.matches('(?i).*\\bon\\w+\\s*=\\s*[\'\"].*')
        && value.size() <= 5000;
    }

    /* Hash SHA-256 hexadecimal (64 caracteres) de un token de setup. */
    function isValidTokenHash(hash) {
      return hash is string
        && hash.size() == 64
        && hash.matches('[0-9a-f]{64}');
    }

    /* Un token de setup es válido si existe un registro en setupTokens cuyo
       documentId (el hash del token) apunta a esta invitación. */
    function setupTokenValid(tokenId, hash) {
      return isValidTokenHash(hash)
        && exists(/databases/$(database)/documents/setupTokens/$(hash))
        && get(/databases/$(database)/documents/setupTokens/$(hash)).data.inviteToken == tokenId;
    }

    /* Tope anti-spam por subcolección social (notes/songs/gifts/rides). */
    function socialCounterCap(name) {
      return name == 'rides' ? 100 : 200;
    }

    /* El contador invitations/{id}/_counters/{name} debe estar por debajo del
       tope. Si el contador no existe (invitación creada antes de introducir
       los contadores) se permite la escritura: el cliente lo crea de forma
       atómica en el mismo batch y el cap aplica a partir de ahí. */
    function socialCounterBelow(tokenId, name) {
      return !exists(/databases/$(database)/documents/invitations/$(tokenId)/_counters/$(name))
        || get(/databases/$(database)/documents/invitations/$(tokenId)/_counters/$(name)).data.count < socialCounterCap(name);
    }

    /* Texto largo visible en la invitación: longitud acotada y caracteres
       seguros (sin HTML/JS) para evitar XSS almacenado. */
    function isValidLongSafeText(value) {
      return isSafeText(value) && value.size() <= 2000;
    }

    /* Whitelist estricta de temas: rechaza cualquier valor que no sea un tema
       soportado por el cliente (THEME_VALUES). Evita que un valor arbitrario
       se guarde y rompa el renderizado o se use para inyección de estilos. */
    function isValidTheme(theme) {
      return theme is string
        && theme.matches('^(golden|forest|rose|linen-soft|blush-pearl|lavender-mist|champagne-bubble|amber-night|onyx-gold|midnight-royal|burgundy-velvet|sapphire-night|emerald-grove|plum-twilight|rainbow|trans|nonbinary|lesbian|bi|pan|ace)$');
    }

    /* URL visible en la invitación: acotada y sin esquemas peligrosos
       (bloquea javascript: e inyección vía atributos). */
    function isValidSafeUrl(url) {
      return url is string && url.size() <= 1000 && !url.matches('(?i).*javascript:.*');
    }

    /* Validación de la configuración para create y update (el admin ya tiene
       sesión activa, que es la garantía real de autorización). Se mantiene
       compacta para no superar el límite de 1000 expresiones de Firestore al
       combinarse con hasActiveSession, pero incluye la validación estricta de
       los campos críticos: nombres, fecha, tema, URLs y texto largo seguro. */
    function isValidInvitationUpdate(data) {
      return data.keys().hasAll(['firstName', 'secondName'])
        && data.firstName is string && data.firstName.size() > 0 && data.firstName.size() <= 100 && isSafeText(data.firstName)
        && data.secondName is string && data.secondName.size() > 0 && data.secondName.size() <= 100 && isSafeText(data.secondName)
        && (!data.keys().hasAny(['weddingDay']) || (data.weddingDay is string && data.weddingDay.matches('^(0?[1-9]|[12][0-9]|3[01])$')))
        && (!data.keys().hasAny(['weddingMonth']) || (data.weddingMonth is string && data.weddingMonth.matches('^(enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre)$')))
        && (!data.keys().hasAny(['weddingYear']) || (data.weddingYear is string && data.weddingYear.matches('^[12][0-9]{3}$')))
        && (!data.keys().hasAny(['theme']) || isValidTheme(data.theme))
        && (!data.keys().hasAny(['inviteMessage']) || (data.inviteMessage is string && data.inviteMessage.size() <= 500 && isSafeText(data.inviteMessage)))
        /* Texto largo visible en la invitación: longitud acotada y sin HTML/JS
           (XSS almacenado). */
        && (!data.keys().hasAny(['storyText']) || isValidLongSafeText(data.storyText))
        && (!data.keys().hasAny(['giftsInfo']) || isValidLongSafeText(data.giftsInfo))
        && (!data.keys().hasAny(['accommodationInfo']) || isValidLongSafeText(data.accommodationInfo))
        && (!data.keys().hasAny(['menuTexto']) || isValidLongSafeText(data.menuTexto))
        && (!data.keys().hasAny(['kidsPolicy']) || isValidLongSafeText(data.kidsPolicy))
        /* URLs de la invitación: acotadas y sin javascript: (XSS). */
        && (!data.keys().hasAny(['weddingSiteURL']) || isValidSafeUrl(data.weddingSiteURL))
        && (!data.keys().hasAny(['instagramUrl']) || isValidSafeUrl(data.instagramUrl))
        && (!data.keys().hasAny(['facebookUrl']) || isValidSafeUrl(data.facebookUrl))
        && (!data.keys().hasAny(['accommodationURL']) || isValidSafeUrl(data.accommodationURL))
        && (!data.keys().hasAny(['bankInfo']) || (data.bankInfo is string && data.bankInfo.size() <= 2000))
        /* Los toggles *Enabled de los campos opcionales del setup NO se
           validan aquí: normalizeConfig los normaliza SIEMPRE a "true"/"false"
           en el cliente, y validarlos añadía ~85 expresiones que superaban el
           límite de complejidad de Firestore con docs grandes (rompía el
           guardado y la renovación de sesión). El contenido se valida igual. */
        && (!data.keys().hasAny(['weddingDressCodeCustom']) || (data.weddingDressCodeCustom is string && data.weddingDressCodeCustom.size() <= 500 && isSafeText(data.weddingDressCodeCustom)))
        && (!data.keys().hasAny(['adminUsername']) || (data.adminUsername is string && data.adminUsername.size() <= 50 && data.adminUsername.matches('^[a-z0-9]*$')))
        && (!data.keys().hasAny(['detailsMapMode']) || data.detailsMapMode in ['iframe', 'name', 'hidden'])
        && (!data.keys().hasAny(['transportMapMode']) || data.transportMapMode in ['iframe', 'name', 'hidden'])
        && (!data.keys().hasAny(['accommodationMapMode']) || data.accommodationMapMode in ['iframe', 'name', 'hidden'])
        && (!data.keys().hasAny(['rsvpDeadline']) || data.rsvpDeadline == '' || data.rsvpDeadline.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && (!data.keys().hasAny(['welcomeVideo']) || data.welcomeVideo == '' || (data.welcomeVideo is string && data.welcomeVideo.size() <= 1000 && data.welcomeVideo.matches('^https://.*')))
        && (!data.keys().hasAny(['welcomeVideoEnabled']) || data.welcomeVideoEnabled == 'true' || data.welcomeVideoEnabled == 'false')
        && (!data.keys().hasAny(['giftList']) || (data.giftList is string && data.giftList.size() <= 10000))
        && (!data.keys().hasAny(['trivia']) || (data.trivia is string && data.trivia.size() <= 10000));
    }

    match /invitations/{tokenId} {
      /* Lectura pública por documento (necesaria para la invitación),
         pero se prohíbe listar/enumerar la colección completa salvo para
         el superadmin (dashboard, exportación y tokens). */
      allow get: if true;
      allow list: if isSuperAdmin();
      /* Alta inicial: el token de setup ya limita quién puede crearla, así que
         se usa la validación reducida (igual que el update). La validación
         completa superaba el límite de 1000 expresiones en producción. */
      allow create: if isValidInvitationUpdate(request.resource.data)
        && (isSuperAdmin()
          || !exists(/databases/$(database)/documents/invitations/$(tokenId)));
      /* Actualización de configuración: solo admin con sesión activa o
         superadmin. Cualquier cuenta autenticada de Firebase Auth NO puede
         editar invitaciones de terceros (evita defacing/phisning).
         _visits se excluye: lo gestiona exclusivamente su propia regla con
         cota de incremento (sin esto un update global con sesión podía fijar
         _visits arbitrariamente). */
      allow update: if isValidInvitationUpdate(request.resource.data)
        && (isSuperAdmin() || hasActiveSession(tokenId))
        /* _visits se conserva en el merge (el doc ya lo tiene tras una
           visita): solo se prohíbe que el update lo MODIFIQUE. La condición
           anterior (hasAny) bloqueaba el guardado cuando el doc tenía
           _visits, porque el merge lo incluía en el request.resource.data. */
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['_visits'])
        /* Los campos de sesión solo los gestiona su regla dedicada (acotada
           a 48 h): el update de configuración no puede fijarlos, o un cliente
           con sesión podría extenderla indefinidamente sin volver a autenticar
           (la rotación de token no la revocaría). */
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['activeSession', 'sessionExpiresAt', 'setupTokenHash']);
      /* Incremento de contador de visitas: cualquiera puede incrementar
         _visits, pero solo en pasos razonables (máx +10 por request) para
         evitar inflar el contador de forma arbitraria. El cliente usa
         increment(1), así que no se rompe. */
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['_visits'])
        && request.resource.data._visits is int
        && request.resource.data._visits >= 0
        && (resource.data.keys().hasAny(['_visits'])
          ? (request.resource.data._visits >= resource.data._visits
            && request.resource.data._visits <= resource.data._visits + 10)
          : request.resource.data._visits <= 10);
      /* Creación/renovación de sesión: exige prueba de conocimiento del
         token de setup (hash con registro en setupTokens). El token legacy
         `_activeSetupToken` ya NO se acepta: era legible públicamente y
         permitía forjar sesiones de administrador. sessionExpiresAt
         limitado a 30min-48h.
         IMPORTANTE: request.time es la hora del SERVIDOR. El cliente envía
         sessionExpiresAt = (hora del cliente) + TTL, que por latencia/reloj es
         siempre un poco anterior a request.time + TTL. Por eso el mínimo debe
         quedar cómodamente por debajo del TTL real del cliente (60 min) para
         no rechazar el login por unos milisegundos de diferencia. */
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeSession', 'sessionExpiresAt', 'setupTokenHash'])
        && request.resource.data.activeSession is timestamp
        && request.resource.data.sessionExpiresAt is timestamp
        && request.resource.data.sessionExpiresAt <= request.time + duration.value(48, 'h')
        && request.resource.data.sessionExpiresAt >= request.time + duration.value(30, 'm')
        && setupTokenValid(tokenId, request.resource.data.setupTokenHash);
      /* Cierre de sesión: solo puede anularse una sesión existente (sin escalada). */
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeSession', 'sessionExpiresAt'])
        && resource.data.activeSession is timestamp
        && request.resource.data.activeSession == null
        && request.resource.data.sessionExpiresAt == null;
      /* Limpieza del token legacy: solo el superadmin retira los campos
         `_activeSetupToken` y `legacyToken` del documento público. */
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['_activeSetupToken', 'legacyToken']);
      allow delete: if isSuperAdmin();

      match /gallery/{imageId} {
        allow read: if true;
        allow create: if request.resource.data.data is string
          && request.resource.data.data.size() <= 1048576
          && isAuthenticatedAdmin(tokenId);
        allow update, delete: if isAuthenticatedAdmin(tokenId);
      }

      match /audio/{docId} {
        allow read: if true;
        allow create: if request.resource.data.data is string
          && request.resource.data.data.size() <= 524288
          && isAuthenticatedAdmin(tokenId);
        allow delete: if isAuthenticatedAdmin(tokenId);
      }

      match /configImages/{imageId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['data', 'createdAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 1048576
          && isAuthenticatedAdmin(tokenId);
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['data', 'createdAt'])
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 1048576
          && isAuthenticatedAdmin(tokenId);
        allow delete: if isAuthenticatedAdmin(tokenId);
      }

      /* ── Contribuciones de los invitados (funciones sociales) ────────────
         Reacciones (contador por emoji), dedicatorias, canciones votadas,
         ofertas de coche compartido y reservas de regalo. El texto público se
         sanea con isSafeText; solo el admin/superadmin puede borrar. */
      match /reactions/{emoji} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int && request.resource.data.count == 1;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count <= 10000;
      }
      match /notes/{noteId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['guestName', 'message', 'createdAt'])
          && isSafeText(request.resource.data.guestName)
          && isSafeText(request.resource.data.message)
          && request.resource.data.message.size() <= 500
          && socialCounterBelow(tokenId, 'notes');
        allow delete: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
      }
      match /songs/{songId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['guestName', 'song', 'votes', 'createdAt'])
          && isSafeText(request.resource.data.guestName)
          && isSafeText(request.resource.data.song)
          && request.resource.data.song.size() <= 200
          && request.resource.data.votes is int && request.resource.data.votes == 1
          && socialCounterBelow(tokenId, 'songs');
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
          && request.resource.data.votes is int
          && request.resource.data.votes == resource.data.votes + 1
          && request.resource.data.votes <= 10000;
        allow delete: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
      }
      match /rides/{rideId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['guestName', 'origin', 'seats', 'createdAt'])
          && isSafeText(request.resource.data.guestName)
          && isSafeText(request.resource.data.origin)
          && request.resource.data.origin.size() <= 200
          && request.resource.data.seats is int
          && request.resource.data.seats >= 1 && request.resource.data.seats <= 8
          && socialCounterBelow(tokenId, 'rides');
        allow delete: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
      }
      match /gifts/{giftId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['itemId', 'reservedBy', 'createdAt'])
          && request.resource.data.itemId is string && request.resource.data.itemId.size() <= 100
          && isSafeText(request.resource.data.reservedBy)
          && socialCounterBelow(tokenId, 'gifts');
        allow delete: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
      }
      /* Contadores anti-spam de las subcolecciones sociales: invitations/{id}/
         _counters/{name} con { count }. El cliente los incrementa de forma
         atómica en el mismo batch que crea el documento (addDoc + setDoc con
         merge), replicando el patrón de rsvpResponses. Un contador inexistente
         (invitación antigua) NO bloquea la creación: el cap se aplica desde
         el primer documento de la versión que introduce los contadores. */
      match /_counters/{counterName} {
        allow read: if true;
        // create limitado a count 0/1: 0 es la inicialización de ConfigContext
        // al guardar la invitación, 1 es el increment del primer documento
        // desde un contador inexistente (setDoc con merge). Un atacante no
        // puede crear el contador directamente en el cap para "quemar" las
        // escrituras de una invitación (como rsvpResponses, que limita a 1).
        allow create: if request.resource.data.keys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count >= 0
          && request.resource.data.count <= 1;
        allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
          && request.resource.data.count is int
          && request.resource.data.count == resource.data.count + 1
          && request.resource.data.count <= socialCounterCap(counterName);
        allow delete: if isAuthenticatedAdmin(tokenId) || isSuperAdmin();
      }
    }

    /* Registros de tokens de setup. El documentId es el hash SHA-256 del token
       (secreto ~2^158), por lo que solo es recuperable con `get` si se conoce
       el token (que permite calcular el documentId). La enumeración (`list`)
       se prohíbe. El `get` debe permitirse SIN sesión activa: es justo lo que
       necesita el flujo de login para localizar la invitación a partir del
       token antes de activar la sesión. La creación solo es válida para
       invitaciones inexistentes (alta inicial) o con sesión activa. */
    match /setupTokens/{hashId} {
      allow get: if true;
      /* Listar solo superadmin: permite limpiar hashes huérfanos al borrar
         invitaciones (query por inviteToken). */
      allow list: if isSuperAdmin();
      /* El alta inicial crea el registro antes de que exista la invitación;
         las rotaciones se hacen con sesión activa. Se exige un formato de
         invitación estricto (10 caracteres alfanuméricos, como genera la app)
         para limitar el spam de registros de tokens hacia invitaciones
         inexistentes. */
      allow create: if isValidTokenHash(hashId)
        && request.resource.data.keys().hasOnly(['inviteToken', 'createdAt'])
        && request.resource.data.inviteToken is string
        && request.resource.data.inviteToken.matches('^[A-Za-z0-9]{10}$')
        && (!exists(/databases/$(database)/documents/invitations/$(request.resource.data.inviteToken))
          || hasActiveSession(request.resource.data.inviteToken)
          || isSuperAdmin());
      allow update: if isSuperAdmin()
        || (resource.data.inviteToken is string
          && hasActiveSession(resource.data.inviteToken));
      allow delete: if isSuperAdmin()
        || (resource.data.inviteToken is string
          && hasActiveSession(resource.data.inviteToken));
    }

    /* Agrupación y contador por invitación: rsvpResponses/{inviteToken} guarda
       el recuento de respuestas (tope 500 anti-spam) y es el "namespace" de la
       subcolección de respuestas de esa invitación. */
    match /rsvpResponses/{inviteToken} {
      /* El contador (solo un entero) es público: useRsvp lo lee para
         incrementarlo en cada respuesta sin sesión de admin. Restringir
         la lectura aquí rompía el RSVP a partir de la segunda respuesta
         (el cliente siempre veía count 0 y el batch fallaba). */
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 500
        && (request.resource.data.count == resource.data.count + 1
          /* Decremento al retirar/borrar respuestas: solo con sesión activa o
             superadmin. Se permite cualquier decremento (>=1) porque un borrado
             en lote o un vaciado eliminan varios documentos a la vez
             (increment(-N)), no solo uno. */
          || ((isSuperAdmin() || hasActiveSession(inviteToken))
            && request.resource.data.count <= resource.data.count - 1));
      allow delete: if isSuperAdmin();
    }

    /* Respuestas RSVP en la subcolección de su invitación:
       rsvpResponses/{inviteToken}/responses/{responseId} */
    match /rsvpResponses/{inviteToken}/responses/{responseId} {
      allow create: if request.resource.data.keys().hasAll(['guestName', 'attendance', 'dietaryInfo', 'submittedAt', 'inviteToken', 'privacyConsent'])
        && request.resource.data.inviteToken == inviteToken
        && request.resource.data.guestName is string
        && request.resource.data.guestName.size() > 0
        && request.resource.data.guestName.size() <= 120
        && isSafeText(request.resource.data.guestName)
        && request.resource.data.attendance in ['yes', 'no']
        && request.resource.data.dietaryInfo is string
        && request.resource.data.dietaryInfo.size() <= 4000
        && isSafeText(request.resource.data.dietaryInfo)
        && request.resource.data.privacyConsent == true
        && (
          !request.resource.data.keys().hasAny(['healthConsent'])
          || request.resource.data.healthConsent == true
        )
        && (
          (request.resource.data.dietaryInfo == ""
            && (!request.resource.data.keys().hasAny(['allergiesOther']) || request.resource.data.allergiesOther == ""))
          || request.resource.data.healthConsent == true
        )
        /* Consentimiento parental en el SERVIDOR: si la fecha de nacimiento
           indica que el invitado es menor de 14 años (fecha de nacimiento
           posterior al límite actual), se exige parentalConsent (GDPR art. 8).
           La edad exacta la valida el cliente.
           IMPORTANTE: actualiza esta fecha cada año. El script CI
           `node scripts/check-consent-cutoff.js` falla si queda obsoleta. */
        && (
          !request.resource.data.keys().hasAny(['birthDate'])
          || request.resource.data.birthDate == ""
          || request.resource.data.birthDate < "2012-08-09"
          || request.resource.data.parentalConsent == true
        )
        && exists(/databases/$(database)/documents/rsvpResponses/$(inviteToken))
        && get(/databases/$(database)/documents/rsvpResponses/$(inviteToken)).data.count < 500
        && (request.resource.data.keys().hasOnly(['guestName', 'attendance', 'dietaryInfo', 'submittedAt', 'inviteToken', 'privacyConsent', 'privacyConsentAt', 'birthDate', 'parentalConsent', 'menuSelection', 'mealChoice', 'healthConsent', 'healthConsentAt', 'companions', 'menuHeadcounts', 'guestNames', 'attendees', 'notAttendingCount', 'companionCount', 'companionNames', 'companionMenus', 'companionAllergies', 'companionAllergiesOther', 'allergiesOther', 'rsvpType', 'mainGuestDocId', 'mainGuestName', 'companionDocIds', 'transportChoice', 'transportMode', 'transportTime', 'transportPlace', 'companionTransportChoices', 'companionTransportModes', 'companionTransportTimes', 'companionTransportPlaces'])
          || request.resource.data.keys().hasOnly(['guestName', 'attendance', 'dietaryInfo', 'submittedAt', 'inviteToken', 'privacyConsent', 'privacyConsentAt', 'birthDate', 'parentalConsent', 'menuSelection', 'mealChoice', 'companions', 'menuHeadcounts', 'guestNames', 'attendees', 'notAttendingCount', 'companionCount', 'companionNames', 'companionMenus', 'companionAllergies', 'companionAllergiesOther', 'allergiesOther', 'rsvpType', 'mainGuestDocId', 'mainGuestName', 'companionDocIds', 'transportChoice', 'transportMode', 'transportTime', 'transportPlace', 'companionTransportChoices', 'companionTransportModes', 'companionTransportTimes', 'companionTransportPlaces']))
        && (!request.resource.data.keys().hasAny(['transportMode']) || request.resource.data.transportMode is string)
        && (!request.resource.data.keys().hasAny(['transportChoice']) || (request.resource.data.transportChoice is string && request.resource.data.transportChoice.size() <= 20))
        && (!request.resource.data.keys().hasAny(['transportTime']) || (request.resource.data.transportTime is string && request.resource.data.transportTime.size() <= 5))
        && (!request.resource.data.keys().hasAny(['transportPlace']) || (request.resource.data.transportPlace is string && request.resource.data.transportPlace.size() <= 120 && isSafeText(request.resource.data.transportPlace)))
        && (!request.resource.data.keys().hasAny(['companionTransportChoices']) || request.resource.data.companionTransportChoices is list)
        && (!request.resource.data.keys().hasAny(['companionTransportModes']) || request.resource.data.companionTransportModes is list)
        && (!request.resource.data.keys().hasAny(['companionTransportTimes']) || request.resource.data.companionTransportTimes is list)
        && (!request.resource.data.keys().hasAny(['companionTransportPlaces']) || request.resource.data.companionTransportPlaces is list);

      allow read: if isSuperAdmin()
        || hasActiveSession(inviteToken);

      allow update: if request.resource.data.attendance in ['yes', 'no']
        && request.resource.data.dietaryInfo is string
        && request.resource.data.inviteToken == inviteToken
        && hasActiveSession(inviteToken)
        && request.resource.data.privacyConsent == true
        && request.resource.data.keys().hasOnly(['attendance', 'dietaryInfo', 'privacyConsent', 'privacyConsentAt', 'healthConsent', 'healthConsentAt', 'birthDate', 'parentalConsent', 'menuSelection', 'mealChoice', 'guestName', 'submittedAt', 'inviteToken', 'companions', 'menuHeadcounts', 'guestNames', 'attendees', 'notAttendingCount', 'companionCount', 'companionNames', 'companionMenus', 'companionAllergies', 'companionAllergiesOther', 'allergiesOther', 'rsvpType', 'mainGuestDocId', 'mainGuestName', 'companionDocIds', 'transportChoice', 'transportMode', 'transportTime', 'transportPlace', 'companionTransportChoices', 'companionTransportModes', 'companionTransportTimes', 'companionTransportPlaces']);

      allow delete: if isSuperAdmin()
        || hasActiveSession(inviteToken);
    }

    /* Lectura global de respuestas (collectionGroup "responses"): solo el
       superadmin puede agregar/exportar datos de todas las invitaciones. */
    match /{path=**}/responses/{responseId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    /* Registro de auditoría: solo el superadmin puede registrarlo (evita
       envenenar el log con entradas falsas). */
    match /auditLog/{docId} {
      allow create: if isSuperAdmin()
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 100;
      allow read: if isSuperAdmin();
    }

    match /couples/{document=**} { allow read, write: if false; }
    match /dataconnect/{document=**} { allow read, write: if false; }
  }
}
