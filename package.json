{
  "name": "wedingo",
  "private": true,
  "version": "2.95.13",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:ci": "oxlint --deny-warnings",
    "preview": "vite preview",
    "translations:check": "node scripts/check-translations.js",
    "audit": "npm audit",
    "audit:prod": "npm audit --production",
    "analyze": "vite-bundle-visualizer",
    "bundle:check": "node scripts/check-bundle-size.js",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "functions:typecheck": "tsc --noEmit -p functions/tsconfig.json",
    "functions:test": "vitest run --config functions/vitest.config.ts",
    "firebase:login": "firebase login",
    "firebase:use": "firebase use --add",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy": "npm run lint && npm run build && firebase deploy --only hosting,firestore:rules",
    "bump": "node scripts/bump-version.js",
    "loadtest": "k6 run scripts/load-test.js",
    "preready": "npm run lint && npm run build && npm run changelog:check",
    "changelog:check": "node scripts/check-changelog.js"
  },
  "dependencies": {
    "@sentry/react": "^10.68.0",
    "firebase": "^12.16.0",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router": "^8.3.0",
    "web-vitals": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "axe-core": "^4.12.1",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "^15.26.0",
    "jsdom": "^30.0.0",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.9"
  }
}
